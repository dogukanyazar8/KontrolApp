<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KontrolApp.MainPage"
             BackgroundColor="White"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="15" VerticalOptions="CenterAndExpand">
            <Frame CornerRadius="25" HasShadow="True" BackgroundColor="#4CAF50">
                <Button Text="Hat Takip"
                        FontSize="38"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="OnHatTakipClicked"/>
            </Frame>
            <Frame CornerRadius="25" HasShadow="True" BackgroundColor="#2196F3">
                <Button Text="Kesim Takip"
                        FontSize="38"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="OnKesimTakipClicked"/>
            </Frame>
            <Frame CornerRadius="25" HasShadow="True" BackgroundColor="#FF9800">
                <Button Text="Otomat Takip"
                        FontSize="38"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="OnOtomatTakipClicked"/>
            </Frame>
            <Frame CornerRadius="25" HasShadow="True" BackgroundColor="#9C27B0">
                <Button Text="Raporlar"
                        FontSize="38"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="OnRaporlarClicked"/>
            </Frame>
            <Frame CornerRadius="25" HasShadow="True" BackgroundColor="Black">
                <Button Text="Ayarlar"
                        FontSize="38"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="OnAyarlarClicked"/>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
