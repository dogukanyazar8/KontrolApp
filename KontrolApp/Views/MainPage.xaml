<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KontrolApp.MainPage"
    NavigationPage.HasNavigationBar="False">

    <!-- Arka plan için degrade -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ece9e6" Offset="0.0" />
            <GradientStop Color="#ffffff" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <StackLayout Padding="30" Spacing="20" VerticalOptions="CenterAndExpand">

            <!-- Logo ve Başlık Alanı -->
            <Grid ColumnSpacing="10" VerticalOptions="Start">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Şirket Logosu (Sola Hizalı) -->
                <Image Source="logo.png" 
                       HeightRequest="120"
                       WidthRequest="100"
                       Aspect="AspectFit"
                       VerticalOptions="Center"
                       Grid.Column="0"/>

                <!-- "Lucca Panel" Yazısı -->
                <StackLayout VerticalOptions="Center" Grid.Column="1">
                    <Label Text="Lucca" 
                           FontSize="40"
                           FontAttributes="Bold"
                           TextColor="#37474F"/>
                    <Label Text="Panel" 
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="#757575"/>
                </StackLayout>
            </Grid>

            <!-- Hat Takip Kartı -->
            <Frame CornerRadius="15" HasShadow="True" BackgroundColor="#4CAF50">
                <Button Text="Hat Takip"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="OnHatTakipClicked"/>
            </Frame>

            <!-- Kesim Takip Kartı -->
            <Frame CornerRadius="15" HasShadow="True" BackgroundColor="#2196F3">
                <Button Text="Kesim Takip"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="OnKesimTakipClicked"/>
            </Frame>

            <!-- Otomat Takip Kartı -->
            <Frame CornerRadius="15" HasShadow="True" BackgroundColor="#FF9800">
                <Button Text="Otomat Takip"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="OnOtomatTakipClicked"/>
            </Frame>

            <!-- Raporlar Kartı -->
            <Frame CornerRadius="15" HasShadow="True" BackgroundColor="#9C27B0">
                <Button Text="Raporlar"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="OnRaporlarClicked"/>
            </Frame>

            <!-- Ayarlar Kartı -->
            <Frame CornerRadius="15" HasShadow="True" BackgroundColor="#37474F">
                <Button Text="Ayarlar"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="OnAyarlarClicked"/>
            </Frame>

        </StackLayout>
    </ScrollView>
</ContentPage>