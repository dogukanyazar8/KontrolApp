<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KontrolApp.OtomatTakipPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F5F5">

    <StackLayout Padding="20" Spacing="10">
        <!-- Başlık -->
        <Label Text="Makine Listesi" 
               FontSize="24" 
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#455A64"/>

        <!-- Makine Listesi (Pull to Refresh Özelliği ile) -->
        <ListView x:Name="MachinesList" 
                  BackgroundColor="Transparent" 
                  SeparatorVisibility="None"
                  HasUnevenRows="True"
                  VerticalOptions="FillAndExpand"
                  IsPullToRefreshEnabled="True"
                  Refreshing="MachinesList_Refreshing">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <!-- Makine Kartı -->
                        <Border Stroke="#CFD8DC" StrokeThickness="2" BackgroundColor="White" Padding="15" Margin="5">
                            <StackLayout Spacing="8">
                                <!-- Otomat Adı, Sipariş Adı ve Sipariş Adedi Yan Yana -->
                                <StackLayout Orientation="Horizontal" Spacing="10">
                                    <Label Text="{Binding otomat_adi}" 
                                           FontSize="18" FontAttributes="Bold"
                                           TextColor="#37474F"
                                           VerticalOptions="Center"/>

                                    <Label Text="{Binding siparis_adi}" 
                                           FontSize="14"
                                           TextColor="#607D8B"
                                           VerticalOptions="Center"/>

                                    <Label Text="{Binding siparis_adet}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#FF5722"
                                           VerticalOptions="Center"/>
                                </StackLayout>

                                <!-- Otomat Durumu ve Tamamlanma Oranı Yan Yana -->
                                <StackLayout Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                                    <Label Text="{Binding otomat_durumu}" 
                                           FontSize="14" 
                                           TextColor="{Binding otomat_durumu}"
                                           VerticalOptions="Center"/>

                                    <!-- Tamamlanma Oranı Bar (Sol Başlangıç) -->
                                    <Grid WidthRequest="150" HeightRequest="10" BackgroundColor="#CFD8DC">
                                        <BoxView HeightRequest="10"
                                                 BackgroundColor="#4CAF50"
                                                 WidthRequest="{Binding progress_width}"
                                                 HorizontalOptions="Start"/>
                                    </Grid>

                                    <!-- Tamamlanma Yüzdesi -->
                                    <Label Text="{Binding tamamlanma_yuzdesi}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#37474F"
                                           VerticalOptions="Center"/>
                                </StackLayout>

                                <!-- Durumu Güncelle Butonu -->
                                <Button Text="Durumu Güncelle"
                                        Clicked="OnUpdateStatusClicked"
                                        CommandParameter="{Binding id}" 
                                        BackgroundColor="#4CAF50"
                                        TextColor="White"
                                        FontSize="14"
                                        Padding="8"
                                        HorizontalOptions="Fill"/>
                            </StackLayout>
                        </Border>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
</ContentPage>