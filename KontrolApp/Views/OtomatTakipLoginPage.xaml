<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KontrolApp.Views.OtomatTakipLoginPage"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <StackLayout Padding="30" Spacing="30" VerticalOptions="Center">
            <Frame CornerRadius="10" HasShadow="True" BackgroundColor="White">
                <Label 
                Text="Otomat Takip Ekranı"
                FontSize="25"
                FontAttributes="Bold"
                Margin="5"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />
            </Frame>

            <Frame CornerRadius="10" HasShadow="True" BackgroundColor="White">
                <Entry x:Name="UserEntry"
               Placeholder="Kullanıcı Adı"
               Keyboard="Email"
               TextColor="Black"
               FontSize="20"        
               BackgroundColor="Transparent"
               Margin="5"/>
            </Frame>

            <Frame CornerRadius="10" HasShadow="True" BackgroundColor="White">
                <Entry x:Name="PasswordEntry"
               Placeholder="Şifre"
               IsPassword="True"
               TextColor="Black"
               FontSize="20"       
               BackgroundColor="Transparent"
               Margin="5"/>
            </Frame>

            <Button Text="Giriş Yap"
              BackgroundColor="#0078D7"
              TextColor="White"
              CornerRadius="10"
              HeightRequest="60"
              FontSize="24"
              FontAttributes="Bold"
              Clicked="OnLoginClicked"/>
        </StackLayout>
    </ScrollView>
</ContentPage>